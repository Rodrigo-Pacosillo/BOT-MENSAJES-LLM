# Renombrar este archivo a .env (Next.js lo lee y lo ignora en git por defecto)
# NUNCA subir este archivo a GitHub ni pegar estos valores en chats.

# --- WhatsApp Cloud API (Meta) ---
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0

# --- Base de datos (Neon / PostgreSQL) ---
DATABASE_URL=

# --- LLM (NVIDIA, compatibilidad OpenAI) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=

# --- App ---
APP_URL=
